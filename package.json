{
  "name": "reflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:check": "node .agents/skills/code-map/scripts/check-code-map.mjs",
    "docs:stamp": "node .agents/skills/code-map/scripts/check-code-map.mjs --stamp",
    "dev": "concurrently -k \"node --watch --env-file-if-exists=.env server/index.js\" \"vite --host 127.0.0.1 --port 4182\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "check": "node --check server/index.js && node --check server/capture.js",
    "test:cloud": "node --test tests/cloud-auth.test.mjs",
    "test:cloud:db": "node --test tests/cloud-database.test.mjs",
    "check:cloud": "node --env-file-if-exists=cloud/.dev.vars scripts/check-cloud-config.mjs",
    "test:cloud:api": "node --test tests/cloud-api.test.mjs",
    "cloud:preview": "wrangler dev --port 4196",
    "cloud:bundle": "wrangler deploy --dry-run",
    "test:cloud:media": "node --test tests/cloud-media.test.mjs",
    "test:cloud:limits": "node --test tests/cloud-limits.test.mjs tests/cloud-network.test.mjs",
    "test:cloud:uploads": "node --test tests/cloud-uploads.test.mjs"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "multer": "^2.0.2",
    "playwright": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
